# Copy to .env for local development. Real values live in Render's environment settings.

# Database URL. A bare postgres:// / postgresql:// URL (what Supabase and Render give you)
# is fine — it is rewritten to the psycopg driver automatically.
# Local throwaway Postgres (see README) example:
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/job_agent

# Authentication (Supabase). Leave AUTH_ENABLED unset/false to keep every route open
# (single-user mode). To enforce logins:
#   1. AUTH_ENABLED=true
#   2. SUPABASE_URL=https://<ref>.supabase.co
#      - verifies access tokens via the project JWKS (Supabase's current ES256 keys)
#      - also lets POST /api/v1/auth/{register,login} proxy to Supabase
#      (SUPABASE_JWT_SECRET is an alternative to JWKS, only for projects still on HS256.)
#   3. SUPABASE_ANON_KEY = the project's public anon key (Settings -> API Keys). Needed
#      for the register / login endpoints.
#   4. SERVICE_TOKEN = any long random string; the scheduled scrape sends it as the
#      X-Service-Token header so the cron does not need a user login.
# AUTH_ENABLED=true
# SUPABASE_URL=https://your-ref.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SERVICE_TOKEN=generate-with-openssl-rand-hex-32

# Email digest of new relevant jobs after each scrape run.
#   RESEND_API_KEY  — required for any mail to go out.
#   Each signed-in user gets their own digest at their account email (toggle + min-score
#   in the profile page). NOTIFY_EMAIL is only a fallback for when auth is disabled or
#   nobody has logged in yet.
#   NOTIFY_FROM_EMAIL: onboarding@resend.dev only delivers to your own Resend account
#   address — to email other users you must verify a domain in Resend and use a sender
#   on it (e.g. jobs@yourdomain.com).
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_FROM_EMAIL=onboarding@resend.dev
# NOTIFY_EMAIL=you@example.com          # fallback recipient(s), comma-separated
# NOTIFY_MIN_SCORE=0                    # default minimum score for users who haven't set one
