# Copy to .env for local development. Set the same keys in the Vercel project settings.
VITE_API_URL=http://127.0.0.1:8000

# Authentication (Supabase). Leave both blank to run the app open (no login screen).
# Fill them in to require sign-in — values from Supabase dashboard -> Project Settings -> API.
# The backend must also have AUTH_ENABLED=true + SUPABASE_JWT_SECRET set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
